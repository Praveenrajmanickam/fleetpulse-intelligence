# FleetPulse AI Analyst configuration - copy to .env and fill in locally. NEVER commit .env.
# Load with:  set -a; source .env; set +a   (then start uvicorn)

# none | mock | anthropic | openai_compatible   (unset/none = analyst unavailable, dashboard still runs)
FLEETPULSE_AI_PROVIDER=mock
# Model name; anthropic defaults to claude-opus-5-5 when empty
FLEETPULSE_AI_MODEL=
# Secret - server side only; never put it in frontend code, logs or audit output
FLEETPULSE_AI_API_KEY=<your-api-key-here>
# Required for openai_compatible (e.g. https://host/v1); optional override for anthropic
FLEETPULSE_AI_BASE_URL=
FLEETPULSE_AI_TIMEOUT_S=30
FLEETPULSE_AI_AUDIT_PATH=data/ai_audit/ai_audit.jsonl

# Data locations (defaults shown)
FLEETPULSE_GOLD_ROOT=data/gold_part3/gold
FLEETPULSE_SILVER_ROOT=data/gold_part3/silver
